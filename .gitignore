# ⚠️ .gitignore는 줄 끝 주석을 지원하지 않는다. `runs/  # 로그`는 주석이 아니라
#    "runs/  # 로그"라는 이름을 찾는 패턴이 된다. 주석은 반드시 제 줄에 둘 것.

# --- 외부 저장소 -----------------------------------------------------------
# 클론으로 복원한다 (루트 README의 "설치"). 둘 다 자체 .git을 가진 클론이라
# 그대로 두면 git이 embedded repo로 경고한다.
walk-these-ways/
mujoco_menagerie/

# --- 학습 산출물 ------------------------------------------------------------
# TensorBoard 로그
runs/
# 체크포인트는 P4 결과 하나만 추적한다 (1.5MB, eval.py를 바로 돌릴 수 있게)
checkpoints/*
!checkpoints/hlc_p4_maze.pkl

# --- 실험 영상 --------------------------------------------------------------
# 재현 가능하고, 수치는 docs/03_results.md가 갖고 있다
*.mp4
example/

# --- 파이썬 -----------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# --- 로컬 환경 --------------------------------------------------------------
# Google Drive 폴더 아이콘 메타데이터
desktop.ini
.vscode/
.claude/
